{
  "include": ["src/**/*"],
  "compilerOptions": {
    "paths": {
      "#states": ["./node_modules/@bemedev/app/lib/states/index.d.ts"],
      "#utils": ["./node_modules/@bemedev/app/lib/utils/index.d.ts"],
      "#utils/*": ["./node_modules/@bemedev/app/lib/utils/*"]
    },
    "lib": ["dom", "esnext"],
    "importHelpers": true,
    "target": "ESNext",
    "declaration": true,
    "sourceMap": true,
    "outDir": "./lib",
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "Bundler",
    "types": ["vitest/globals", "node"],
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "declarationMap": true
  }
}
