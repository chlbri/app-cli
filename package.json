{
  "name": "@bemedev/app-cli",
  "version": "0.2.2",
  "description": "CLI for generating TypeScript typings for lib @bemedev/app",
  "keywords": [
    "@bemedev/app",
    "cli",
    "state machines",
    "types",
    "typings"
  ],
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app-cli.git"
  },
  "bin": {
    "app": "lib/index.js"
  },
  "files": [
    "lib",
    "public"
  ],
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "pnpm rm:lib && pnpm run rolldown && pnpm run generate",
    "ci": "CI_START=$(date +%s) && pnpm run config:off && pnpm run lint && pnpm run test && pnpm run p-q && echo \"\n✅ CI takes $(($(date +%s) - CI_START))s\n\"",
    "ci:admin": "pnpm run rm && pnpm run upgrade:fast && pnpm run ci",
    "clean": "pnpm run rm && pnpm run config",
    "config": "pnpm install",
    "config:off": "pnpm run config --offline",
    "dev": "tsx src/index.ts dev -o ./src/__tests__/app.gen.ts",
    "generate": "tsx src/index.ts generate -o ./src/__tests__/app.gen.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "_lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint": "pnpm run fmt && pnpm run lint:fix",
    "lint:watch": "onchange --await-write-finish 5500 \"**/*\" -- pnpm run lint",
    "build:watch": "onchange --await-write-finish 1500 -d 10000 -v \"**/*.ts\" -- pnpm run build",
    "prepublishOnly": "",
    "prepare": "husky",
    "add:tarball": "build-tests pre",
    "preview": "pnpm run build && pnpm run add:tarball && app-typings generate -w",
    "pretest": "pnpm run build && pnpm run size",
    "posttest": "pnpm run fmt",
    "p-q": "pretty-quick",
    "rinit": "pnpm run rm && pnpm run config",
    "rinit:off": "pnpm run rm && pnpm run config:off",
    "rimraf": "pnpx rimraf -rf",
    "rm": "pnpm run rimraf -- node_modules pnpm-lock.yaml",
    "rm:lib": "pnpm run rimraf lib",
    "rolldown": "rolldown -c",
    "size": "size-limit",
    "test": "pnpm run test:coverage --no-coverage",
    "test:only": "pnpm run test:coverage --no-coverage",
    "test:coverage": "vitest run",
    "test:watch": "vitest",
    "upgrade": "pnpm dlx @bemedev/upgrade-npm-package",
    "upgrade:fast": "pnpm up --latest && pnpm add -D @bemedev/app@0.1.3-canary"
  },
  "dependencies": {
    "cmd-ts": "0.15.0",
    "node-watch": "0.7.4",
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@bemedev/app": "0.1.3-canary",
    "@bemedev/app-ts": "3.0.2",
    "@bemedev/build-tests": "0.1.2",
    "@bemedev/dev-utils": "^0.7.0",
    "@bemedev/fsf": "1.0.1",
    "@bemedev/rollup-config": "0.2.2",
    "@bemedev/sleep": "0.2.2",
    "@bemedev/types": "0.4.2",
    "@bemedev/vitest-alias": "0.0.3",
    "@bemedev/vitest-exclude": "0.1.1",
    "@bemedev/vitest-extended": "1.5.3",
    "@size-limit/file": "12.1.0",
    "@types/node": "25.9.1",
    "@types/picomatch": "4.0.3",
    "@types/shelljs": "0.10.0",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/ui": "4.1.7",
    "eslint": "10.4.0",
    "glob": "^13.0.6",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "pretty-quick": "4.2.2",
    "rolldown": "1.0.2",
    "shelljs": "0.10.0",
    "size-limit": "12.1.0",
    "tslib": "2.8.1",
    "tsx": "^4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "peerDependencies": {
    "@bemedev/app": "0.1.0-canary"
  },
  "size-limit": [
    {
      "path": "lib/*.js",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.cjs",
      "limit": "10 KB"
    }
  ],
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f"
}
